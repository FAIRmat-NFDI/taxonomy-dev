# Copy to backend/core/.env for local development.
# Production (Render): never edit by hand — set GitHub Secrets / Variables; .github/workflows/core.yml
# syncs them to the Render service on every deploy (see docs/RENDER.md).

PORT=4000
# This server's public URL (OAuth callbacks are built from it: <PUBLIC_URL>/auth/<provider>/callback)
PUBLIC_URL=http://localhost:4000
# Frontend origins allowed for CORS and as post-login redirect targets (comma-separated, no trailing slash)
FRONTEND_ORIGINS=http://localhost:5173
# Long random string; signs session tokens and seals login data. Generate: openssl rand -hex 32
# Required (≥ 32 chars) when NODE_ENV=production.
SESSION_SECRET=
SESSION_TTL_SECONDS=28800

# ── GitHub App ───────────────────────────────────────────────────────────────
# "Sign in with GitHub" (direct mode): the app's Client ID + client secret.
#   Callback URL in the GitHub App: http://localhost:4000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# On-behalf-of proxy for university / email users: App ID + private key (.pem).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_FILE=./github-app.private-key.pem
# or inline (CI / Render): GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# Repositories the proxy may read/write (owner/repo, comma-separated).
# Empty = this repository (git remote "origin"), which also holds main.ttl.
GITHUB_PROXY_REPOS=

# ── OpenID Connect providers (any number; id = lowercase name) ──────────────
OIDC_PROVIDERS=helmholtz,keycloak

# University login — Helmholtz ID (test instance: https://login-dev.helmholtz.de/oauth2)
#   Redirect URI to register: http://localhost:4000/auth/helmholtz/callback
OIDC_HELMHOLTZ_LABEL=Helmholtz ID
OIDC_HELMHOLTZ_ISSUER=https://login.helmholtz.de/oauth2
OIDC_HELMHOLTZ_CLIENT_ID=
OIDC_HELMHOLTZ_CLIENT_SECRET=
OIDC_HELMHOLTZ_SCOPES=openid profile email

# Email + password — local Keycloak (see backend/iam/). Swap the issuer for an existing (e.g. NOMAD) Keycloak later.
OIDC_KEYCLOAK_LABEL=Email & password
OIDC_KEYCLOAK_ISSUER=http://localhost:8080/realms/fairtaxonomy
OIDC_KEYCLOAK_CLIENT_ID=fairtaxonomy-backend
OIDC_KEYCLOAK_CLIENT_SECRET=dev-only-change-me
OIDC_KEYCLOAK_SCOPES=openid profile email
# No separate "Sign in with Keycloak" button — it powers the email/password form instead
OIDC_KEYCLOAK_BUTTON=false

# Which OIDC provider handles the email + password form
PASSWORD_PROVIDER=keycloak
# Sign-up from the web app (no email verification). Must be a Keycloak provider whose client
# has a service account with realm-management → manage-users (preconfigured in backend/iam/docker/realm).
REGISTRATION_PROVIDER=keycloak
REGISTRATION_RATE_LIMIT=10
