# Local development configuration for app/ (git-ignored). All VITE_* values are PUBLIC (bundled into the app).

# Served at the root locally (CI sets /<repo>/ for GitHub Pages)
VITE_BASE=/

# Core API (npm run dev in backend/core)
VITE_API_BASE_URL=http://localhost:4000

# Ontology source: main.ttl at the root of this repository
VITE_GH_OWNER=FAIRmat-NFDI
VITE_GH_REPO=taxonomy-dev
VITE_GH_BRANCH=main
VITE_ONTOLOGY_PATH=main.ttl

# Signed-out visitors can read unprotected branches of a public repository (read-only).
VITE_PROTECTED_BRANCHES_PUBLIC=false

# Issues go to the source repository by default
VITE_GH_ISSUES_OWNER=
VITE_GH_ISSUES_REPO=
