# Copy to app/.env.local for development. All VITE_* values are PUBLIC (bundled into the app).

# Base path for GitHub Pages project sites, e.g. /taxonomy-playground/
VITE_BASE=/

# Backend (auth + GitHub proxy). Any origin, or a same-origin path like /api later.
VITE_API_BASE_URL=http://localhost:4000

# Ontology source repository
VITE_GH_OWNER=harikrishnan06
VITE_GH_REPO=fairmat-taxonomy-v2
VITE_GH_BRANCH=main
VITE_ONTOLOGY_PATH=main.ttl

# Signed-out visitors can read unprotected branches of a public repository (read-only).
# Protected branches need sign-in unless this is true.
VITE_PROTECTED_BRANCHES_PUBLIC=false

# Repository where comment issues are created (defaults to the source repo)
VITE_GH_ISSUES_OWNER=
VITE_GH_ISSUES_REPO=
