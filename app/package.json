{
  "name": "fairtaxonomy-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Frontend-only OWL/TTL visualizer and editor (pyLODE / WebProtege inspired), GitHub-backed.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/titillium-web": "^5.3.0",
    "@mui/material": "^9.5.0",
    "@mui/x-tree-view": "^9.15.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@tanstack/react-query": "^5.104.2",
    "cytoscape": "^3.34.3",
    "d3-force": "^3.0.0",
    "n3": "^2.13.12",
    "oxigraph": "^0.5.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.3.0",
    "react-resizable-panels": "^4.14.5",
    "react-router": "^8.4.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3-force": "^3.0.10",
    "@types/n3": "^1.26.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.4"
  }
}
